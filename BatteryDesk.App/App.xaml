<Application x:Class="BatteryDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBg" Color="#131E2E" />
        <SolidColorBrush x:Key="PanelAlt" Color="#1B293B" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#54D6A0" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#26364A" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#07130F" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
